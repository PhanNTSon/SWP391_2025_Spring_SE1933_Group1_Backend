<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Biến cấu hình -->
    <property name="LOG_PATH" value="logs" />

    <!-- CLI Log Pattern: Ngắn gọn, chỉ lấy tối đa 2 dòng lỗi, bỏ qua framework traceback -->
    <property name="CLI_LOG_PATTERN"
        value="[%d{HH:mm:ss}] %-5level %logger{20} - %msg %ex{2, org.springframework, org.apache, org.hibernate, java.base, java.lang.reflect}%n" />

    <!-- File Log Pattern: Giới hạn 15 dòng lỗi, bỏ qua framework traceback -->
    <property name="FILE_LOG_PATTERN"
        value="[%d{yyyy-MM-dd HH:mm:ss}] %-5level %logger{36} - %msg%n%ex{15, org.springframework, org.apache, org.hibernate, java.base, java.lang.reflect}" />

    <!-- Metrics Pattern: Dành cho file log thông số -->
    <property name="METRICS_PATTERN" value="[%d{yyyy-MM-dd HH:mm:ss}] %-5level %logger{36} - %msg%n" />

    <!-- 1. Console Appender: Hiển thị log ra màn hình CLI (Ngắn gọn) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CLI_LOG_PATTERN}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- 2. Rolling File Appender cho Errors: Ghi đè log lỗi (WARN, ERROR) -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/errors.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/errors-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 3. Rolling File Appender cho App Logs: Ghi lại toàn bộ log vận hành chung -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 4. Rolling File Appender cho Metrics: Thông số room/round/transaction -->
    <appender name="METRICS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/metrics-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${METRICS_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Thiết lập Log Levels cho các thư viện -->
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.springframework" level="INFO" />

    <!-- 
        Chuyển các log INFO/DEBUG của các module nghiệp vụ sang file metrics.log.
        additivity="false" để các log này không bị in trùng ra màn hình Console hay app.log.
        (Nhưng vẫn cấu hình cho lỗi chạy vào ERROR_FILE nếu có)
    -->
    <logger name="io.phanson.casino_backend.session_coordinator" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <logger name="io.phanson.casino_backend.wallet" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <logger name="io.phanson.casino_backend.betting" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <logger name="io.phanson.casino_backend.taixiu" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <logger name="io.phanson.casino_backend.crash_game" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <logger name="io.phanson.casino_backend.slot_game" level="INFO" additivity="false">
        <appender-ref ref="METRICS_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </logger>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="APP_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

</configuration>